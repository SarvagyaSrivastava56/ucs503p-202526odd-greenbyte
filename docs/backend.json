{
  "entities": {
    "User": {
      "title": "User",
      "description": "Represents a user in the application.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "role": { "type": "string", "enum": ["student", "society_admin", "super_admin"] },
        "interests": { "type": "array", "items": { "type": "string" } },
        "societyIds": { "type": "array", "items": { "type": "string" } },
        "points": { "type": "number" },
        "deviceTokens": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["name", "email", "role"]
    },
    "Society": {
      "title": "Society",
      "description": "Represents a student society or club.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "logoUrl": { "type": "string", "format": "uri" },
        "admins": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["name", "description"]
    },
    "Event": {
      "title": "Event",
      "description": "Represents an event hosted by a society.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "societyId": { "type": "string" },
        "category": { "type": "string" },
        "venue": { "type": "string" },
        "isOnline": { "type": "boolean" },
        "link": { "type": "string", "format": "uri" },
        "bannerUrl": { "type": "string", "format": "uri" },
        "startAt": { "type": "string", "format": "date-time" },
        "endAt": { "type": "string", "format": "date-time" },
        "capacity": { "type": "number" },
        "isPaid": { "type": "boolean" },
        "price": { "type": "number" },
        "status": { "type": "string", "enum": ["draft", "published", "archived"] },
        "tags": { "type": "array", "items": { "type": "string" } },
        "counters": {
          "type": "object",
          "properties": {
            "rsvpCount": { "type": "number" },
            "views": { "type": "number" },
            "checkIns": { "type": "number" }
          }
        }
      },
      "required": ["title", "societyId", "category", "startAt", "status"]
    },
    "Rsvp": {
      "title": "Rsvp",
      "description": "Represents a user's RSVP for an event.",
      "type": "object",
      "properties": {
        "userId": {"type": "string"},
        "status": { "type": "string", "enum": ["rsvped", "waitlisted", "cancelled"] },
        "qrCode": { "type": "string" },
        "checkInAt": { "type": "string", "format": "date-time" }
      },
       "required": ["userId", "status"]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "A message within an event's chat thread.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "text": { "type": "string" },
        "imageUrl": { "type": "string", "format": "uri" },
        "createdAt": { "type": "string", "format": "date-time" },
        "reactions": {
          "type": "object",
          "additionalProperties": { "type": "number" }
        }
      },
      "required": ["uid", "createdAt"]
    },
    "Announcement": {
      "title": "Announcement",
      "description": "A bulk announcement to a segment of users.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "body": { "type": "string" },
        "target": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "body", "createdAt"]
    },
    "Report": {
      "title": "Report",
      "description": "A report submitted by a user for moderation.",
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["event", "chat", "user"] },
        "refIds": { "type": "array", "items": { "type": "string" } },
        "reason": { "type": "string" },
        "status": { "type": "string", "enum": ["open", "closed"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["type", "refIds", "reason", "status", "createdAt"]
    },
    "UserPreferences": {
      "title": "UserPreferences",
      "description": "User-specific preferences for notifications and content.",
      "type": "object",
      "properties": {
        "categories": { "type": "array", "items": { "type": "string" } },
        "digestFrequency": { "type": "string", "enum": ["daily", "weekly", "none"] },
        "notificationToggles": {
          "type": "object",
           "properties": {
             "reminders": {"type": "boolean"},
             "announcements": {"type": "boolean"},
             "chat": {"type": "boolean"}
           }
        }
      }
    }
  },
  "auth": {
    "providers": [
      "password"
    ]
  },
  "firestore": {
    "structure": [
      {
        "path": "users/{uid}",
        "definition": {
          "entityName": "User",
          "schema": { "$ref": "#/entities/User" },
          "description": "Stores public user profile data."
        }
      },
      {
        "path": "societies/{societyId}",
        "definition": {
          "entityName": "Society",
          "schema": { "$ref": "#/entities/Society" },
          "description": "Stores information about each student society."
        }
      },
      {
        "path": "events/{eventId}",
        "definition": {
          "entityName": "Event",
          "schema": { "$ref": "#/entities/Event" },
          "description": "Main collection for all events."
        }
      },
      {
        "path": "events/{eventId}/rsvps/{uid}",
        "definition": {
          "entityName": "Rsvp",
          "schema": { "$ref": "#/entities/Rsvp" },
          "description": "Subcollection for event RSVPs. Document ID is the user's UID."
        }
      },
      {
        "path": "events/{eventId}/chat/{messageId}",
        "definition": {
          "entityName": "ChatMessage",
          "schema": { "$ref": "#/entities/ChatMessage" },
          "description": "Subcollection for real-time chat messages for an event."
        }
      },
      {
        "path": "announcements/{id}",
        "definition": {
          "entityName": "Announcement",
          "schema": { "$ref": "#/entities/Announcement" },
          "description": "Collection for admin-pushed announcements."
        }
      },
      {
        "path": "reports/{id}",
        "definition": {
          "entityName": "Report",
          "schema": { "$ref": "#/entities/Report" },
          "description": "Collection for user-submitted reports for moderation."
        }
      },
      {
        "path": "preferences/{uid}",
        "definition": {
          "entityName": "UserPreferences",
          "schema": { "$ref": "#/entities/UserPreferences" },
          "description": "Stores individual user preferences for notifications and content."
        }
      }
    ]
  }
}
