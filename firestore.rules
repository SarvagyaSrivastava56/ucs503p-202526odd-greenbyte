rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }
    
    function hasRole(role) {
      return isSignedIn() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == role;
    }
    
    function isSocietyAdmin() {
      // Check if user email contains 'society' as a fallback
      return isSignedIn() && (
        hasRole('society_admin') || 
        hasRole('super_admin') ||
        (request.auth.token.email.matches('.*society.*') || request.auth.token.email.matches('.*@.*\\.society'))
      );
    }
    
    function isSuperAdmin() {
      return hasRole('super_admin');
    }
    
    function isSocietyAdminOf(societyId) {
      return isSignedIn() && (
        hasRole('super_admin') ||
        (hasRole('society_admin') && 
         exists(/databases/$(database)/documents/societies/$(societyId)) &&
         get(/databases/$(database)/documents/societies/$(societyId)).data.admins.hasAny([request.auth.uid])) ||
        // Allow society admins based on email pattern
        (request.auth.token.email.matches('.*society.*') || request.auth.token.email.matches('.*@.*\\.society'))
      );
    }
    
    function isEventCreator(eventId) {
      return isSignedIn() && 
             exists(/databases/$(database)/documents/events/$(eventId)) &&
             get(/databases/$(database)/documents/events/$(eventId)).data.createdBy == request.auth.uid;
    }
    
    function validateTimestamp(field) {
      return request.resource.data[field] is timestamp;
    }
    
    function validateString(field, minLen, maxLen) {
      return request.resource.data[field] is string &&
             request.resource.data[field].size() >= minLen &&
             request.resource.data[field].size() <= maxLen;
    }
    
    // Users collection: /users/{userId}
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId) &&
                       validateString('displayName', 1, 100) &&
                       validateString('email', 3, 255) &&
                       request.resource.data.role in ['student', 'society_admin', 'super_admin'] &&
                       request.resource.data.keys().hasAll(['displayName', 'email', 'role']) &&
                       (!request.resource.data.keys().hasAny(['createdAt']) || validateTimestamp('createdAt'));
      allow update: if isOwner(userId) &&
                       // Users can't change their own role
                       (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role'])) &&
                       // Validate updated fields
                       (!request.resource.data.keys().hasAny(['displayName']) || validateString('displayName', 1, 100)) &&
                       (!request.resource.data.keys().hasAny(['updatedAt']) || validateTimestamp('updatedAt'));
      allow delete: if isOwner(userId) || isSuperAdmin();
      
      // User's RSVPs: /users/{userId}/rsvps/{rsvpId}
      match /rsvps/{rsvpId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) &&
                                 validateString('eventId', 1, 200) &&
                                 request.resource.data.status in ['rsvped', 'waitlisted', 'cancelled'];
        allow delete: if isOwner(userId);
      }
      
      // User's favorite events: /users/{userId}/favorites/{eventId}
      match /favorites/{eventId} {
        allow read, write: if isOwner(userId);
      }
    }
    
    // Societies collection: /societies/{societyId}
    match /societies/{societyId} {
      allow read: if isSignedIn();
      allow create: if isSocietyAdmin() &&
                       validateString('name', 2, 100) &&
                       validateString('description', 0, 500) &&
                       request.resource.data.admins is list &&
                       request.resource.data.admins.hasAny([request.auth.uid]);
      allow update: if isSocietyAdminOf(societyId) &&
                       validateString('name', 2, 100) &&
                       validateString('description', 0, 500) &&
                       // Ensure at least one admin remains
                       request.resource.data.admins.size() > 0;
      allow delete: if isSuperAdmin();
      
      // Team members: /societies/{societyId}/team/{memberId}
      match /team/{memberId} {
        allow read: if isSignedIn();
        allow create: if isSocietyAdminOf(societyId) &&
                         validateString('email', 3, 255) &&
                         request.resource.data.role in ['owner', 'admin', 'editor', 'check-in-only'] &&
                         request.resource.data.status in ['pending', 'active'];
        allow update: if isSocietyAdminOf(societyId) &&
                         request.resource.data.role in ['owner', 'admin', 'editor', 'check-in-only'];
        allow delete: if isSocietyAdminOf(societyId);
      }
      
      // Audit log: /societies/{societyId}/auditLog/{logId}
      match /auditLog/{logId} {
        allow read: if isSocietyAdminOf(societyId);
        allow create: if isSocietyAdminOf(societyId);
        allow update, delete: if false; // Audit logs are immutable
      }
    }
    
    // Events collection: /events/{eventId}
    match /events/{eventId} {
      // Allow anyone to read published events
      allow read: if true;
      allow create: if isSocietyAdmin() &&
                       validateString('title', 3, 200) &&
                       validateString('description', 10, 5000) &&
                       validateString('societyId', 1, 200) &&
                       validateString('venue', 1, 200) &&
                       validateString('category', 1, 50) &&
                       request.resource.data.capacity is int &&
                       request.resource.data.capacity >= 0 &&
                       request.resource.data.status in ['draft', 'published', 'archived'] &&
                       request.resource.data.isOnline is bool &&
                       request.resource.data.isPaid is bool &&
                       request.resource.data.createdBy == request.auth.uid &&
                       // Validate society admin relationship
                       isSocietyAdminOf(request.resource.data.societyId);
                       
      allow update: if (isEventCreator(eventId) || isSocietyAdminOf(resource.data.societyId)) &&
                       // Can't change creator or society after creation
                       (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['createdBy', 'societyId'])) &&
                       // Validate fields if changed
                       (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['title']) || validateString('title', 3, 200)) &&
                       (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['description']) || validateString('description', 10, 5000)) &&
                       (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['status']) || request.resource.data.status in ['draft', 'published', 'archived']);
                       
      allow delete: if isEventCreator(eventId) || isSocietyAdminOf(resource.data.societyId) || isSuperAdmin();
      
      // Event RSVPs: /events/{eventId}/rsvps/{userId}
      match /rsvps/{userId} {
        allow read: if isSignedIn();
        allow create: if isOwner(userId) &&
                         request.resource.data.status in ['rsvped', 'waitlisted', 'cancelled'] &&
                         validateTimestamp('createdAt');
        allow update: if isOwner(userId) &&
                         request.resource.data.status in ['rsvped', 'waitlisted', 'cancelled'] &&
                         (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['createdAt']));
        allow delete: if isOwner(userId);
      }
      
      // Event Chat: /events/{eventId}/chat/{messageId}
      match /chat/{messageId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() &&
                         request.resource.data.uid == request.auth.uid &&
                         validateTimestamp('createdAt') &&
                         // Must have either text or imageUrl
                         (request.resource.data.keys().hasAny(['text']) || request.resource.data.keys().hasAny(['imageUrl'])) &&
                         (!request.resource.data.keys().hasAny(['text']) || validateString('text', 1, 2000));
        // Chat messages cannot be updated or deleted (immutable)
        allow update: if false;
        allow delete: if isEventCreator(eventId) || isSuperAdmin();
      }
    }
    
    // Announcements collection: /announcements/{announcementId}
    match /announcements/{announcementId} {
      allow read: if isSignedIn();
      allow create: if isSocietyAdmin() &&
                       validateString('title', 3, 200) &&
                       validateString('body', 10, 500) &&
                       request.resource.data.targets is list;
      allow update: if isSocietyAdmin();
      allow delete: if isSocietyAdmin() || isSuperAdmin();
    }
    
    // Ticket Tiers collection: /ticketTiers/{tierId}
    match /ticketTiers/{tierId} {
      allow read: if isSignedIn();
      allow create: if isSocietyAdmin() &&
                       validateString('eventId', 1, 200) &&
                       validateString('name', 1, 100) &&
                       request.resource.data.price is number &&
                       request.resource.data.capacity is int &&
                       request.resource.data.capacity >= 0;
      allow update: if isSocietyAdmin();
      allow delete: if isSocietyAdmin() || isSuperAdmin();
    }
    
    // Promo Codes collection: /promoCodes/{codeId}
    match /promoCodes/{codeId} {
      allow read: if isSignedIn();
      allow create: if isSocietyAdmin() &&
                       validateString('code', 2, 50) &&
                       validateString('societyId', 1, 200) &&
                       request.resource.data.discount is number &&
                       request.resource.data.type in ['percentage', 'fixed'] &&
                       request.resource.data.maxUses is int;
      allow update: if isSocietyAdmin();
      allow delete: if isSocietyAdmin() || isSuperAdmin();
    }
    
    // Deny all other paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
